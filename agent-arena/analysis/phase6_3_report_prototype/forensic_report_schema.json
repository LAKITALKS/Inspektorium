{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-arena/phase6_3/forensic_report_schema",
  "title": "Agent Arena Claim-Forensics Report (Phase 6.3 prototype)",
  "description": "Strict, versioned output contract for a single claim-forensics report produced by agent_arena.forensic_report.build_forensic_report. All labels use the frozen taxonomy; confidence follows Phase 6.1 VALID/MISSING/INVALID semantics and is never coerced to 0.0; no canonical/private ids may appear. The Python validator validate_forensic_report enforces this contract in code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_schema_version", "report_id", "generated_at", "analysis_status",
    "synthetic_fixture", "development_or_production_status", "status_banner",
    "claim", "verdict", "evidence", "failure_modes", "reader_impact",
    "uncertainty", "recommended_revision", "provenance"
  ],
  "properties": {
    "report_schema_version": {"const": "6.3.0"},
    "report_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": ["string", "null"], "description": "ISO-8601 passthrough from input, or null. Never a wall-clock injected at build time."},
    "analysis_status": {"enum": ["complete", "parser_failure", "insufficient_input"]},
    "synthetic_fixture": {"type": "boolean"},
    "development_or_production_status": {"enum": ["development", "production"]},
    "status_banner": {"type": "array", "items": {"type": "string"}},

    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_text"],
      "properties": {
        "claim_text": {"type": ["string", "null"]},
        "claim_context": {"type": ["string", "null"]},
        "claim_source_reference": {"type": ["string", "null"]},
        "claim_scope": {"type": ["string", "null"]},
        "intended_reader_or_audience": {"type": ["string", "null"]}
      }
    },

    "verdict": {
      "type": "object", "additionalProperties": false,
      "required": ["predicted_label", "verdict_title", "verdict_summary",
                   "confidence_status", "confidence_value", "confidence_interpretation",
                   "classification_note"],
      "properties": {
        "predicted_label": {
          "oneOf": [
            {"enum": ["solid", "overclaim", "correlation_vs_causation", "mechanism_vs_evidence"]},
            {"type": "null"}
          ],
          "description": "Frozen taxonomy, or null for parser_failure / insufficient_input."
        },
        "verdict_title": {"type": "string"},
        "verdict_summary": {"type": "string"},
        "confidence_status": {"enum": ["VALID", "MISSING", "INVALID"]},
        "confidence_value": {
          "oneOf": [
            {"type": "number", "minimum": 0.0, "maximum": 1.0},
            {"type": "null"}
          ],
          "description": "A number in [0,1] ONLY when confidence_status is VALID; otherwise null. Booleans are rejected (a bool is INVALID and yields null here)."
        },
        "confidence_interpretation": {"type": "string"},
        "classification_note": {"type": "string"}
      }
    },

    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_items", "supporting", "contradicting_or_limiting",
                   "missing_comparison_group", "missing_causal_chain",
                   "missing_human_evidence", "evidence_sufficiency",
                   "evidence_sufficiency_rationale"],
      "properties": {
        "evidence_items": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["text", "source_reference", "tier", "role", "why_it_matters"],
            "properties": {
              "text": {"type": "string"},
              "source_reference": {"type": ["string", "null"]},
              "tier": {"enum": ["cell", "animal", "biomarker", "limited_human", "clinical_human", "unknown", "not_applicable"]},
              "role": {"enum": ["supporting", "weakening", "contradictory", "missing_expected"]},
              "why_it_matters": {"type": ["string", "null"]}
            }
          }
        },
        "supporting": {"type": "array", "items": {"type": "string"}},
        "contradicting_or_limiting": {"type": "array", "items": {"type": "string"}},
        "missing_comparison_group": {"type": ["boolean", "null"]},
        "missing_causal_chain": {"type": ["boolean", "null"]},
        "missing_human_evidence": {"type": ["boolean", "null"]},
        "evidence_sufficiency": {"enum": ["sufficient", "insufficient", "unknown"]},
        "evidence_sufficiency_rationale": {"type": ["string", "null"]}
      }
    },

    "failure_modes": {
      "type": "object", "additionalProperties": false,
      "required": ["detected", "none_detected"],
      "properties": {
        "detected": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["mode", "rationale", "evidence_refs"],
            "properties": {
              "mode": {"enum": [
                "correlation_vs_causation_conflation", "inappropriate_generalization",
                "evidence_tier_mismatch", "unsupported_superiority_claim",
                "benchmark_exaggeration", "decorative_or_weak_hedging",
                "mechanism_to_human_benefit_leap", "conclusion_exceeds_results",
                "missing_comparison_group", "missing_causal_chain", "missing_human_evidence"
              ]},
              "rationale": {"type": "string", "minLength": 1},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "none_detected": {"type": "boolean"}
      }
    },

    "reader_impact": {
      "type": "object", "additionalProperties": false,
      "required": ["risk_level", "risk_rationale", "likely_reader_misunderstanding",
                   "affected_decision_type", "risk_uncertainty", "not_a_harm_probability_note"],
      "properties": {
        "risk_level": {"enum": ["low", "moderate", "high", "critical", "unknown"]},
        "risk_rationale": {"type": ["string", "null"]},
        "likely_reader_misunderstanding": {"type": ["string", "null"]},
        "affected_decision_type": {"type": ["string", "null"]},
        "risk_uncertainty": {"type": ["string", "null"]},
        "not_a_harm_probability_note": {"type": "string"}
      }
    },

    "uncertainty": {
      "type": "object", "additionalProperties": false,
      "required": ["unresolved_questions", "missing_evidence", "ambiguity",
                   "alternative_plausible_label", "alternative_label_rationale",
                   "scope_limitations", "confidence_caveat", "development_caveat"],
      "properties": {
        "unresolved_questions": {"type": "array", "items": {"type": "string"}},
        "missing_evidence": {"type": "array", "items": {"type": "string"}},
        "ambiguity": {"type": ["string", "null"]},
        "alternative_plausible_label": {
          "oneOf": [
            {"enum": ["solid", "overclaim", "correlation_vs_causation", "mechanism_vs_evidence"]},
            {"type": "null"}
          ]
        },
        "alternative_label_rationale": {"type": ["string", "null"]},
        "scope_limitations": {"type": "array", "items": {"type": "string"}},
        "confidence_caveat": {"type": "string"},
        "development_caveat": {"type": ["string", "null"]}
      }
    },

    "recommended_revision": {
      "type": "object", "additionalProperties": false,
      "required": ["defensible_rewrite", "rewrite_available", "rewrite_verification",
                   "rewrite_verification_note", "rewrite_rationale",
                   "claims_to_remove_or_narrow", "evidence_qualifiers_to_add",
                   "claims_that_remain_supportable", "rewrite_guard"],
      "properties": {
        "defensible_rewrite": {"type": ["string", "null"], "description": "Copied verbatim from validated input, or null (not provided, or blocked by the guard). Never synthesized."},
        "rewrite_available": {"type": "boolean"},
        "rewrite_verification": {
          "enum": ["unverified_proposal", "blocked_unsupported_new_facts", "no_rewrite_supplied"],
          "description": "A present rewrite is ALWAYS 'unverified_proposal' — passing the numeric-containment guard is NOT factual/semantic verification."
        },
        "rewrite_verification_note": {"type": "string"},
        "rewrite_rationale": {"type": ["string", "null"]},
        "claims_to_remove_or_narrow": {"type": "array", "items": {"type": "string"}},
        "evidence_qualifiers_to_add": {"type": "array", "items": {"type": "string"}},
        "claims_that_remain_supportable": {"type": "array", "items": {"type": "string"}},
        "rewrite_guard": {
          "type": "object", "additionalProperties": false,
          "required": ["checked", "unsupported_new_facts", "status"],
          "properties": {
            "checked": {"type": "boolean"},
            "unsupported_new_facts": {"type": "array", "items": {"type": "string"}},
            "status": {"enum": ["clean", "blocked", "no_rewrite"]}
          }
        }
      }
    },

    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "provider", "prompt_contract_version", "repository_commit",
                   "analysis_source", "input_digest_sha256",
                   "report_generation_digest_sha256", "parser_status", "warnings", "audit_trail"],
      "properties": {
        "model": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]},
        "prompt_contract_version": {"type": ["string", "null"]},
        "repository_commit": {"type": ["string", "null"]},
        "analysis_source": {"type": ["string", "null"]},
        "input_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "report_generation_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "parser_status": {"enum": ["ok", "failed", "unknown"]},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "audit_trail": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "x_forbidden_anywhere": ["study-forensics-*", "BIAA-*", "HLD-*", "DEV-####", "salt_hex", "private_manifest", "/Users/", "AgentArena_IAA_Private", "internal_only"],
  "x_frozen_vocabularies": {
    "labels": ["solid", "overclaim", "correlation_vs_causation", "mechanism_vs_evidence"],
    "evidence_tiers": ["cell", "animal", "biomarker", "limited_human", "clinical_human"],
    "reader_impact_risk": ["low", "moderate", "high", "critical", "unknown"],
    "confidence_status": ["VALID", "MISSING", "INVALID"]
  }
}
