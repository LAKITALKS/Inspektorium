  "definition": {
    "plan_id": "AA-P5A-MEOV-PAIRED-001",
    "comparison_id": "AA-P5A-MEOV-COMPARISON-001",
    "research_question": "Under contemporary matched execution, does replacing the historically visible ME-versus-OV instruction with the existing normative taxonomy and precedence rule reduce contract-discordant primary labels on deliberately exposed cases without degrading relevant controls?",
    "hypothesis": "The taxonomy-aligned prompt will reduce ME-versus-OV contract-discordant primary labels in the genuine-overlap and Shape-B strata; it is not assumed to improve every label, model, calibration measure or individual unit.",
    "model_keys": [
      "haiku",
      "sonnet"
    ],
    "n_replications": 3,
    "execution_mode": "independent_model_adjudication",
    "qa_profile": "phase5a-condition-contract-production-qa/v2",
    "unit_selection_rule": "Use only active Phase-7A Class-B independent base units already available before prospective model output. Exclude nested perturbation variants, retired units and holdout material. Predeclare all active A2/A7 mechanism-adversarial units as genuine ME/OV overlap; the three neutral/boundary ME anchors as ME-specific controls; four explicit A5/B2 surrogate Shape-B units; four clear non-mechanistic OV units spanning A1, neutral and B1; and two clear solid plus two clear CvC controls. Selection uses taxonomy exposure and family coverage, never historical prediction correctness.",
    "unit_strata": [
      {
        "stratum_id": "genuine_me_overclaim_overlap",
        "purpose": "Genuine documented biological-mechanism trigger coexists with rhetorically inflated human benefit.",
        "unit_ids": [
          "P7A-ADV-003",
          "P7A-ADV-004",
          "P7A-ADV-013",
          "P7A-ADV-017"
        ]
      },
      {
        "stratum_id": "mechanism_specific_controls",
        "purpose": "Clear ME anchors testing preservation of the documented specific trigger.",
        "unit_ids": [
          "P7A-BND-009",
          "P7A-BND-010",
          "P7A-NEU-004"
        ]
      },
      {
        "stratum_id": "shape_b_surrogate_controls",
        "purpose": "Explicit biomarker or surrogate-to-clinical Shape-B cases that must not be stretched into ME.",
        "unit_ids": [
          "P7A-ADV-009",
          "P7A-ADV-010",
          "P7A-BND-015",
          "P7A-BND-016"
        ]
      },
      {
        "stratum_id": "nonmechanistic_overclaim_controls",
        "purpose": "Clear rhetorical inflation without a genuine ME or CvC trigger.",
        "unit_ids": [
          "P7A-ADV-001",
          "P7A-ADV-002",
          "P7A-NEU-002",
          "P7A-BND-001"
        ]
      },
      {
        "stratum_id": "solid_and_cvc_controls",
        "purpose": "Relevant other-label controls for unintended solid or CvC precedence regressions.",
        "unit_ids": [
          "P7A-NEU-001",
          "P7A-BND-012",
          "P7A-NEU-003",
          "P7A-ADV-005"
        ]
      }
